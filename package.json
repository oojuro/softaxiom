{
  "name": "@softaxiom/memory",
  "version": "0.1.0-preparation",
  "private": true,
  "type": "module",
  "license": "(Apache-2.0 AND MIT)",
  "files": [
    "bin/*.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "agent-text/",
    "docs/MEMORY.md",
    "docs/ARCHITECTURE.md",
    "docs/MEMORY_VERIFICATION.md",
    "docs/ADAPTERS.md",
    "docs/EVENT_INBOX.md",
    "docs/CI_AND_BUILDS.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "assets/softaxiom-logo.svg",
    "docs/OPEN_SOURCE_PREPARATION.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/check-licenses.js",
    "docs/LOCAL_BROWSER.md",
    "docs/RADAR.md",
    "docs/LOCAL_VERIFICATION.md",
    "docs/ADAPTER_SDK.md",
    "docs/SHARED_CORE.md",
    "docs/DEPENDENCIES.json",
    "licenses/",
    "npm-shrinkwrap.json",
    "install.sh",
    "install.ps1",
    "docs/INSTALL.md",
    "docs/CLI.md",
    "docs/SKILLS.md",
    "docs/PRODUCT.md",
    "docs/MODELS.md",
    "docs/LOCAL_EXECUTION.md",
    "docs/CHAT.md",
    "docs/CHAT_BROWSER.md",
    "docs/OPENCLAW.md",
    "docs/OPENCLAW_PROVENANCE.json",
    "docs/DELEGATION.md",
    "examples/specialists/evidence-audit.py",
    "docs/ENGINE_REPLACEMENT.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "sa": "bin/softaxiom.js",
    "sa-memory": "bin/softaxiom.js",
    "softaxiom": "bin/softaxiom.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "npm run build && node scripts/check-core.ts && npm run check:licenses && npm test",
    "check:licenses": "node scripts/check-licenses.ts",
    "prepack": "npm run build && node scripts/check-core.ts && node scripts/check-licenses.ts --quiet",
    "build": "node scripts/build.ts",
    "typecheck": "npm run build"
  },
  "exports": {
    "./adapters": {
      "types": "./lib/adapters.d.ts",
      "import": "./lib/adapters.js"
    },
    "./*": "./*",
    "./core/*": {
      "types": "./lib/core/*.d.ts",
      "import": "./lib/core/*.js"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@anthropic-ai/sdk": "0.133.0",
    "ai": "7.0.143",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "openai": "7.31.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.36",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3"
  }
}
