{
  "name": "@softaxiom/memory",
  "version": "0.1.0-preparation",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin/",
    "lib/",
    "agent-text/",
    "docs/MEMORY.md",
    "docs/ARCHITECTURE.md",
    "docs/MEMORY_VERIFICATION.md",
    "docs/ADAPTERS.md",
    "docs/EVENT_INBOX.md",
    "docs/CI_AND_BUILDS.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/OPEN_SOURCE_PREPARATION.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/check-licenses.js",
    "docs/LOCAL_BROWSER.md",
    "docs/RADAR.md",
    "docs/LOCAL_VERIFICATION.md",
    "docs/ADAPTER_SDK.md",
    "docs/SHARED_CORE.md",
    "docs/DEPENDENCIES.json",
    "licenses/",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "sa-memory": "bin/softaxiom.js",
    "softaxiom": "bin/softaxiom.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "npm run build && node scripts/check-core.js && npm run check:licenses && npm test",
    "check:licenses": "node scripts/check-licenses.js",
    "prepack": "npm run build && node scripts/check-core.js && node scripts/check-licenses.js --quiet",
    "build": "node scripts/build-core.js"
  },
  "exports": {
    "./adapters": {
      "types": "./lib/adapters.d.ts",
      "import": "./lib/adapters.js"
    },
    "./*": "./*",
    "./core/*": {
      "types": "./lib/core/*.d.ts",
      "import": "./lib/core/*.js"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "ai": "7.0.143",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
